<Window x:Class="Kompass.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KOMPASS"
        Height="650"
        Width="1050"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F3F5F7">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->

        <Border Grid.Row="0"
                Background="#263746">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="KOMPASS"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Energie- und Modernisierungsberatung"
                               Foreground="#D9E0E5"
                               FontSize="13"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="Aktualisieren"
                        Command="{Binding ProjekteLadenCommand}"
                        Padding="18,8"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>

            </Grid>

        </Border>

        <!-- Inhalt -->

        <Grid Grid.Row="1"
              Margin="24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Projektliste -->

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D6DCE1"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Projekte"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#263746"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Projekte}"
                              SelectedItem="{Binding AusgewaehltesProjekt}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Projektname"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Alternativen"
                                                Binding="{Binding AnzahlAlternativen}"
                                                Width="120"/>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="260"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- Bedienbereich -->

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D6DCE1"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="18">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="0,0,8,0">

                    <TextBlock Text="Projekt anlegen"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#263746"/>

                    <TextBlock Text="Projektname"
                               Margin="0,24,0,6"
                               FontWeight="SemiBold"/>

                    <TextBox Text="{Binding NeuerProjektname,
                                           UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,5"/>

                    <Button Content="Projekt anlegen"
                            Command="{Binding ProjektErstellenCommand}"
                            Height="38"
                            Margin="0,14,0,0"/>

                    <Separator Margin="0,24"/>

                    <TextBlock Text="Ausgewähltes Projekt"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Projektname"
                               Margin="0,14,0,6"
                               FontWeight="SemiBold"/>

                               <TextBox Text="{Binding BearbeiteterProjektname,
                                        UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="True"
                                        Height="34"
                                        Padding="8,5"/>

                    <Button Content="Änderungen speichern"
                            Command="{Binding ProjektAktualisierenCommand}"
                            Height="38"
                            Margin="0,12,0,0"/>

                    <Button Content="Projekt öffnen"
                            Command="{Binding ProjektOeffnenCommand}"
                            Height="42"
                            Margin="0,12,0,0"
                            FontWeight="SemiBold"/>

<TextBlock Text="{Binding AusgewaehltesProjekt.Id}"
           Margin="0,12,0,0"
           Foreground="#6B747C"
           FontSize="11"
           TextWrapping="Wrap"/>

<Button Content="Ausgewähltes Projekt löschen"
        Command="{Binding ProjektLoeschenCommand}"
        Height="38"
        Margin="0,12,0,0"/>

                    <Separator Margin="0,22"/>

                    <TextBlock Text="Fachdatenbanken"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding FachdatenStatusText}"
                               Margin="0,8,0,0"
                               Foreground="#5D6A73"
                               TextWrapping="Wrap"/>

                    <Button Content="Fachdaten prüfen"
                            Command="{Binding FachdatenPruefenCommand}"
                            Height="38"
                            Margin="0,12,0,0"/>

                    <Button Content="Fachdaten importieren"
                            Command="{Binding FachdatenImportierenCommand}"
                            Height="38"
                            Margin="0,8,0,0"
                            FontWeight="SemiBold"/>

                </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

        <!-- Statusleiste -->

        <Border Grid.Row="2"
                Background="#E2E7EB"
                BorderBrush="#CCD3D8"
                BorderThickness="0,1,0,0">

            <Grid Margin="16,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#34444F"/>

                <TextBlock Grid.Column="1"
                           Text="KOMPASS Desktop"
                           VerticalAlignment="Center"
                           Foreground="#6B747C"/>

            </Grid>

        </Border>

    </Grid>

</Window>
