<UserControl x:Class="Kompass.Desktop.Views.FoerderungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <TextBlock Text="Förderung"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{Binding Projektname}"
                       Margin="0,6,0,26"
                       Foreground="#66747E"
                       FontSize="15"/>

            <!-- Lade-Schaltfläche und Status -->

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,20">

                <Button Content="Daten laden"
                        Command="{Binding LadenCommand}"
                        Width="130"
                        Height="38"
                        FontWeight="SemiBold"/>

                <Border Margin="16,0,0,0"
                        Background="#EEF2F4"
                        CornerRadius="4"
                        Padding="14,0"
                        VerticalAlignment="Center">

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#34444F"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                </Border>

            </StackPanel>

            <!-- Förderübersicht je Alternative -->

            <Border Background="White"
                    BorderBrush="#D5DBDF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Förderübersicht je Alternative"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Margin="0,6,0,16"
                               Text="Zugeordnete Förderprogramme für jede Modernisierungsalternative dieses Projekts."
                               Foreground="#687680"
                               TextWrapping="Wrap"/>

                    <DataGrid ItemsSource="{Binding Alternativen}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MinHeight="80">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Pos."
                                                Binding="{Binding B56Position}"
                                                Width="50"/>

                            <DataGridTextColumn Header="Modernisierungsalternative"
                                                Binding="{Binding Bezeichnung}"
                                                Width="220"/>

                            <DataGridTextColumn Header="Gesamtkosten"
                                                Binding="{Binding GesamtkostenText}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Förderprogramme"
                                                Binding="{Binding AnzahlProgrammeText}"
                                                Width="*"/>

                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>

                            <DataTemplate>

                                <Border Padding="16,8"
                                        Background="#F5F7F8">

                                    <StackPanel>

                                        <TextBlock Text="Zugeordnete Förderprogramme:"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>

                                        <DataGrid ItemsSource="{Binding ZugeordneteProgramme}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  MaxHeight="200">

                                            <DataGrid.Columns>

                                                <DataGridTextColumn Header="Kennung"
                                                                    Binding="{Binding Programmkennung}"
                                                                    Width="150"/>

                                                <DataGridTextColumn Header="Version"
                                                                    Binding="{Binding Version}"
                                                                    Width="70"/>

                                                <DataGridTextColumn Header="Fördersatz"
                                                                    Binding="{Binding FoerdersatzText}"
                                                                    Width="100"/>

                                                <DataGridTextColumn Header="Höchstbetrag"
                                                                    Binding="{Binding HoechstbetragText}"
                                                                    Width="120"/>

                                                <DataGridTextColumn Header="Gültigkeit"
                                                                    Binding="{Binding GueltigkeitText}"
                                                                    Width="*"/>

                                            </DataGrid.Columns>

                                        </DataGrid>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </DataGrid.RowDetailsTemplate>

                    </DataGrid>

                </StackPanel>

            </Border>

            <!-- Förderprogrammkatalog -->

            <Border Background="White"
                    BorderBrush="#D5DBDF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="Förderprogrammkatalog"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Margin="0,6,0,16"
                               Text="{Binding KatalogStatusText}"
                               Foreground="#687680"/>

                    <DataGrid ItemsSource="{Binding Foerderprogramme}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MinHeight="80">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Kennung"
                                                Binding="{Binding Programmkennung}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Version"
                                                Binding="{Binding Version}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Fördersatz"
                                                Binding="{Binding FoerdersatzText}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Höchstbetrag"
                                                Binding="{Binding HoechstbetragText}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Gültigkeit"
                                                Binding="{Binding GueltigkeitText}"
                                                Width="140"/>

                            <DataGridTextColumn Header="Zielgruppe"
                                                Binding="{Binding Zielgruppe}"
                                                Width="*"/>

                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>

                            <DataTemplate>

                                <Border Padding="16,10"
                                        Background="#F5F7F8">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Fördergegenstand:"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding Foerdergegenstand}"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Margin="0,8,0,0"
                                                   Text="Mindestanforderungen:"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Margin="0,8,0,0"
                                                   Text="{Binding TechnischeMindestanforderungen}"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Margin="0,8,0,0"
                                                   Text="Pflichtnachweise:"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Margin="0,8,0,0"
                                                   Text="{Binding Pflichtnachweise}"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Margin="0,8,0,0"
                                                   Text="Quellenstand:"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   Margin="0,8,0,0"
                                                   Text="{Binding Quellenstand}"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </DataGrid.RowDetailsTemplate>

                    </DataGrid>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
