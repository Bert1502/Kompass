<UserControl x:Class="Kompass.Desktop.Views.B56ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <TextBlock Text="B56-Import"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{Binding Projektname}"
                       Margin="0,6,0,26"
                       Foreground="#66747E"
                       FontSize="15"/>

            <Border Background="White"
                    BorderBrush="#D5DBDF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="B56-Ergebnisdatei"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Margin="0,6,0,22"
                               Text="Wählen Sie den Excel-Export aus B56 aus. Unterstützt werden XLSX- und XLSM-Dateien."
                               Foreground="#687680"
                               TextWrapping="Wrap"/>

                    <Button Content="B56-Datei auswählen"
                            Command="{Binding DateiAuswaehlenCommand}"
                            Width="210"
                            Height="42"
                            HorizontalAlignment="Left"/>

                    <Border Margin="0,22,0,0"
                            Background="#F5F7F8"
                            BorderBrush="#D5DBDF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Dateiname:"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Dateiname}"
                                       TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,10,0,0"
                                       Text="Dateityp:"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,10,0,0"
                                       Text="{Binding Dateityp}"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,10,0,0"
                                       Text="Dateigröße:"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,10,0,0"
                                       Text="{Binding Dateigroesse}"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Margin="0,10,0,0"
                                       Text="Dateipfad:"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Margin="0,10,0,0"
                                       Text="{Binding AusgewaehlterDateipfad}"
                                       TextWrapping="Wrap"/>

                        </Grid>

                    </Border>

                    <StackPanel Margin="0,20,0,0"
                                Orientation="Horizontal">

                        <Button Content="Import starten"
                                Command="{Binding ImportStartenCommand}"
                                Width="150"
                                Height="42"
                                FontWeight="SemiBold"/>

                        <Button Content="Auswahl entfernen"
                                Command="{Binding AuswahlEntfernenCommand}"
                                Width="150"
                                Height="42"
                                Margin="12,0,0,0"/>

                    </StackPanel>

                    <Border Margin="0,22,0,0"
                            Background="#EEF2F4"
                            CornerRadius="4"
                            Padding="14">

                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#34444F"
                                   TextWrapping="Wrap"/>

                    </Border>

                </StackPanel>

            </Border>

            <Border Margin="0,24,0,0"
                    Background="White"
                    BorderBrush="#D5DBDF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="Importhistorie"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Margin="0,6,0,16"
                               Text="{Binding HistorieStatusText}"
                               Foreground="#687680"/>

                    <DataGrid ItemsSource="{Binding Importhistorie}"
                              SelectedItem="{Binding AusgewaehlterHistorieneintrag}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MinHeight="100">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Importiert am"
                                                Binding="{Binding ImportiertAmText}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Dateiname"
                                                Binding="{Binding Originaldateiname}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Größe"
                                                Binding="{Binding DateigroesseText}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding SnapshotStatus}"
                                                Width="190"/>
                            <DataGridTextColumn Header="SHA-256"
                                                Binding="{Binding KurzHash}"
                                                Width="120"/>
                        </DataGrid.Columns>

                    </DataGrid>

                    <Button Margin="0,14,0,0"
                            Content="Ergebnisse anzeigen"
                            Command="{Binding ErgebnisseAnzeigenCommand}"
                            Width="180"
                            Height="38"
                            HorizontalAlignment="Left"/>

                    <StackPanel Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <Button Content="Fachlich bestätigen"
                                Command="{Binding SnapshotBestaetigenCommand}"
                                Width="170"
                                Height="38"/>
                        <Button Content="Verwerfen"
                                Command="{Binding SnapshotVerwerfenCommand}"
                                Width="120"
                                Height="38"
                                Margin="10,0,0,0"/>
                        <Button Content="Ins Projektmodell übernehmen"
                                Command="{Binding InProjektmodellUebernehmenCommand}"
                                Width="230"
                                Height="38"
                                Margin="10,0,0,0"/>
                    </StackPanel>

                </StackPanel>

            </Border>

            <Border Margin="0,24,0,0"
                    Background="White"
                    BorderBrush="#D5DBDF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Fachliche Importergebnisse"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,16"
                               Text="{Binding ErgebnisStatusText}"
                               Foreground="#687680"/>

                    <TextBlock Text="Bestandskennwerte"
                               Margin="0,4,0,8"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <DataGrid ItemsSource="{Binding Bestandskennwerte}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kennwert" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Wert" Binding="{Binding Wert, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="Einheit" Binding="{Binding Einheit}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Bauteile"
                               Margin="0,20,0,8"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <DataGrid ItemsSource="{Binding Bauteile}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Bauteilcode}" Width="90"/>
                            <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Bezeichnung}" Width="*"/>
                            <DataGridTextColumn Header="Nachbarseite" Binding="{Binding Nachbarseite}" Width="180"/>
                            <DataGridTextColumn Header="Fläche" Binding="{Binding Flaeche, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="U-Wert" Binding="{Binding UWert, StringFormat=N3}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Modernisierungsvarianten"
                               Margin="0,20,0,8"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <DataGrid ItemsSource="{Binding Modernisierungsalternativen}"
                              SelectedItem="{Binding AusgewaehlteModernisierungsalternative}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="75"/>
                            <DataGridTextColumn Header="Variante" Binding="{Binding Bezeichnung}" Width="220"/>
                            <DataGridTextColumn Header="Beschreibung" Binding="{Binding Beschreibung}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Kennwerte der ausgewählten Variante"
                               Margin="0,16,0,8"
                               FontWeight="SemiBold"/>
                    <DataGrid ItemsSource="{Binding AusgewaehlteModernisierungsalternative.Kennwerte}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kennwert" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Wert" Binding="{Binding Wert, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="Einheit" Binding="{Binding Einheit}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Bauteile der ausgewählten Variante"
                               Margin="0,16,0,8"
                               FontWeight="SemiBold"/>
                    <DataGrid ItemsSource="{Binding AusgewaehlteModernisierungsalternative.Bauteile}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Bauteilcode}" Width="90"/>
                            <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Bezeichnung}" Width="*"/>
                            <DataGridTextColumn Header="Nachbarseite" Binding="{Binding Nachbarseite}" Width="180"/>
                            <DataGridTextColumn Header="Fläche" Binding="{Binding Flaeche, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="U-Wert" Binding="{Binding UWert, StringFormat=N3}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Importhinweise"
                               Margin="0,20,0,8"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Importwarnungen}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="10"
                                        Background="#FFF7E6"
                                        BorderBrush="#E6C878"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <TextBlock Text="{Binding}"
                                               Foreground="#624D17"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
