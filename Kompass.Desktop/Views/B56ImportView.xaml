<UserControl x:Class="Kompass.Desktop.Views.B56ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <TextBlock Text="B56-Import"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{Binding Projektname}"
                       Margin="0,6,0,26"
                       Foreground="#66747E"
                       FontSize="15"/>

            <Border Background="White"
                    BorderBrush="#D5DBDF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="B56-Ergebnisdatei"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Margin="0,6,0,22"
                               Text="Wählen Sie den Excel-Export aus B56 aus. Unterstützt werden XLSX- und XLSM-Dateien."
                               Foreground="#687680"
                               TextWrapping="Wrap"/>

                    <Button Content="B56-Datei auswählen"
                            Command="{Binding DateiAuswaehlenCommand}"
                            Width="210"
                            Height="42"
                            HorizontalAlignment="Left"/>

                    <Border Margin="0,22,0,0"
                            Background="#F5F7F8"
                            BorderBrush="#D5DBDF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Dateiname:"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Dateiname}"
                                       TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,10,0,0"
                                       Text="Dateityp:"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,10,0,0"
                                       Text="{Binding Dateityp}"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,10,0,0"
                                       Text="Dateigröße:"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,10,0,0"
                                       Text="{Binding Dateigroesse}"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Margin="0,10,0,0"
                                       Text="Dateipfad:"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Margin="0,10,0,0"
                                       Text="{Binding AusgewaehlterDateipfad}"
                                       TextWrapping="Wrap"/>

                        </Grid>

                    </Border>

                    <StackPanel Margin="0,20,0,0"
                                Orientation="Horizontal">

                        <Button Content="Import starten"
                                Command="{Binding ImportStartenCommand}"
                                Width="150"
                                Height="42"
                                FontWeight="SemiBold"/>

                        <Button Content="Auswahl entfernen"
                                Command="{Binding AuswahlEntfernenCommand}"
                                Width="150"
                                Height="42"
                                Margin="12,0,0,0"/>

                    </StackPanel>

                    <Border Margin="0,22,0,0"
                            Background="#EEF2F4"
                            CornerRadius="4"
                            Padding="14">

                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#34444F"
                                   TextWrapping="Wrap"/>

                    </Border>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>