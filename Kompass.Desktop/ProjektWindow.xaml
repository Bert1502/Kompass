<Window x:Class="Kompass.Desktop.ProjektWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Kompass.Desktop.ViewModels"
        xmlns:views="clr-namespace:Kompass.Desktop.Views"
        mc:Ignorable="d"
        Title="{Binding Fenstertitel}"
        Height="760"
        Width="1250"
        MinHeight="620"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="NavigationsButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#C7DCE8"/>
                    <Setter Property="BorderBrush" Value="#2878A0"/>
                    <Setter Property="BorderThickness" Value="4,0,0,0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#163F55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type viewModels:B56ImportViewModel}">
            <views:B56ImportView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:KostenViewModel}">
            <views:KostenView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ModernisierungsalternativenViewModel}">
            <views:ModernisierungsalternativenView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:WirtschaftlichkeitViewModel}">
            <views:WirtschaftlichkeitView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:FoerderungViewModel}">
            <views:FoerderungView/>
        </DataTemplate>

    </Window.Resources>

    <Grid Background="#F3F5F7">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->

        <Border Grid.Row="0"
                Background="#263746">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="KOMPASS"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding Projektname}"
                               Foreground="#D9E0E5"
                               FontSize="14"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <TextBlock Text="Projekt-ID"
                               Foreground="#B9C4CC"
                               FontSize="11"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="{Binding ProjektId}"
                               Foreground="White"
                               FontSize="11"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Hauptbereich -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->

            <Border Grid.Column="0"
                    Background="#E7EBEE"
                    BorderBrush="#CCD3D8"
                    BorderThickness="0,0,1,0">

                <StackPanel Margin="14">

                    <TextBlock Text="PROJEKTBEREICHE"
                               Margin="10,8,10,12"
                               Foreground="#687680"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <Button Content="Projektübersicht"
                            Command="{Binding ProjektuebersichtCommand}"
                            Tag="{Binding IstProjektuebersichtAktiv}"
                            Style="{StaticResource NavigationsButton}"/>

                    <Button Content="B56-Import"
                            Command="{Binding B56ImportCommand}"
                            Tag="{Binding IstB56ImportAktiv}"
                            Style="{StaticResource NavigationsButton}"/>

                    <Button Content="Kosten"
                            Command="{Binding KostenCommand}"
                            Tag="{Binding IstKostenAktiv}"
                            Style="{StaticResource NavigationsButton}"/>

                    <Button Content="Modernisierungsalternativen"
                            Command="{Binding ModernisierungsalternativenCommand}"
                            Tag="{Binding IstModernisierungsalternativenAktiv}"
                            Style="{StaticResource NavigationsButton}"/>

                    <Button Content="Wirtschaftlichkeit"
                            Command="{Binding WirtschaftlichkeitCommand}"
                            Tag="{Binding IstWirtschaftlichkeitAktiv}"
                            Style="{StaticResource NavigationsButton}"/>

                    <Button Content="Förderung"
                            Command="{Binding FoerderungCommand}"
                            Tag="{Binding IstFoerderungAktiv}"
                            Style="{StaticResource NavigationsButton}"/>

                    <Button Content="Bericht"
                            Command="{Binding BerichtCommand}"
                            Tag="{Binding IstBerichtAktiv}"
                            Style="{StaticResource NavigationsButton}"/>

                </StackPanel>

            </Border>

            <!-- Arbeitsbereich -->

            <Grid Grid.Column="1">

                <!-- Dynamischer Inhalt, zum Beispiel B56-Import -->

                <ContentControl Content="{Binding AktuellerInhalt}">

                    <ContentControl.Style>

                        <Style TargetType="ContentControl">

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding AktuellerInhalt}"
                                             Value="{x:Null}">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </ContentControl.Style>

                </ContentControl>

                <!-- Projektübersicht -->

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <ScrollViewer.Style>

                        <Style TargetType="ScrollViewer">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding AktuellerInhalt}"
                                             Value="{x:Null}">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </ScrollViewer.Style>

                    <StackPanel Margin="30">

                        <TextBlock Text="{Binding AktiverBereich}"
                                   Foreground="#263746"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding Projektname}"
                                   Margin="0,6,0,24"
                                   Foreground="#66747E"
                                   FontSize="15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#D5DBDF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="18">

                                <StackPanel>

                                    <TextBlock Text="Projekt"
                                               Foreground="#687680"
                                               FontSize="12"/>

                                    <TextBlock Text="{Binding Projektname}"
                                               Margin="0,7,0,0"
                                               Foreground="#263746"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                            <Border Grid.Column="2"
                                    Background="White"
                                    BorderBrush="#D5DBDF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="18">

                                <StackPanel>

                                    <TextBlock Text="Modernisierungsalternativen"
                                               Foreground="#687680"
                                               FontSize="12"/>

                                    <TextBlock Text="{Binding AnzahlAlternativen}"
                                               Margin="0,7,0,0"
                                               Foreground="#263746"
                                               FontSize="24"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                            <Border Grid.Column="4"
                                    Background="White"
                                    BorderBrush="#D5DBDF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="18">

                                <StackPanel>

                                    <TextBlock Text="Projektmodell"
                                               Foreground="#687680"
                                               FontSize="12"/>

                                    <TextBlock Text="{Binding ProjektmodellStatus}"
                                               Margin="0,7,0,0"
                                               Foreground="#263746"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <Border Margin="0,18,0,0"
                                Background="White"
                                BorderBrush="#D5DBDF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="Quell-Snapshot"
                                           Foreground="#687680"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding QuellSnapshotId}"
                                           Margin="0,7,0,0"
                                           Foreground="#263746"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,28,0,0"
                                Background="White"
                                BorderBrush="#D5DBDF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="24">

                            <StackPanel>

                                <TextBlock Text="Projektbearbeitung"
                                           Foreground="#263746"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>

                                <TextBlock Margin="0,8,0,20"
                                           Text="Als nächster Arbeitsschritt muss der aktuelle B56-Excel-Export eingelesen werden."
                                           Foreground="#687680"
                                           TextWrapping="Wrap"/>

                                <Button Content="B56-Import öffnen"
                                        Command="{Binding B56ImportCommand}"
                                        Width="190"
                                        Height="42"
                                        HorizontalAlignment="Left"
                                        FontWeight="SemiBold"/>

                            </StackPanel>

                        </Border>

                        <Border Margin="0,28,0,0"
                                Background="White"
                                BorderBrush="#D5DBDF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="24">

                            <StackPanel>

                                <TextBlock Text="Arbeitsablauf"
                                           Foreground="#263746"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>

                                <TextBlock Margin="0,6,0,22"
                                           Text="KOMPASS führt schrittweise durch die Projektbearbeitung."
                                           Foreground="#687680"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="1"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Projektinformationen prüfen"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Objekt, Auftraggeber und Bearbeitung erfassen."
                                                   Foreground="#687680"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ProjektinformationenWorkflowStatus}"
                                               Foreground="#687680"
                                               VerticalAlignment="Center"/>

                                </Grid>

                                <Separator Margin="0,16"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="2"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="B56-Ergebnis importieren"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Excel-Datei einlesen, prüfen und archivieren."
                                                   Foreground="#687680"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding B56WorkflowStatus}"
                                               Foreground="#687680"
                                               VerticalAlignment="Center"/>

                                </Grid>

                                <Separator Margin="0,16"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="3"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Kostenschätzung importieren"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Kosten von Architektur und TGA zuordnen."
                                                   Foreground="#687680"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding KostenWorkflowStatus}"
                                               Foreground="#687680"
                                               VerticalAlignment="Center"/>

                                </Grid>

                                <Separator Margin="0,16"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="4"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Wirtschaftlichkeit auswerten"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Bilanzierte und praktische Wirtschaftlichkeit vergleichen."
                                                   Foreground="#687680"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding WirtschaftlichkeitWorkflowStatus}"
                                               Foreground="#687680"
                                               VerticalAlignment="Center"/>

                                </Grid>

                                <Separator Margin="0,16"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="5"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Bericht erstellen"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Ergebnisse und Empfehlungen dokumentieren."
                                                   Foreground="#687680"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding BerichtWorkflowStatus}"
                                               Foreground="#687680"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- Statusleiste -->

        <Border Grid.Row="2"
                Background="#E2E7EB"
                BorderBrush="#CCD3D8"
                BorderThickness="0,1,0,0">

            <Grid Margin="16,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#34444F"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding AktiverBereich}"
                           VerticalAlignment="Center"
                           Foreground="#6B747C"/>

            </Grid>

        </Border>

    </Grid>

</Window>
